{
  "$meta": {
    "name": "Universal Design System",
    "version": "2.2.0",
    "style": "iOS/macOS 27 Liquid Glass, emerald-teal accent",
    "note": "Single source of truth. Edit values here, then run scripts/build_tokens.py to regenerate every platform file and DESIGN_SYSTEM.md."
  },
  "palette": {
    "gray": {
      "0": "#FFFFFF",
      "50": "#F2F5F4",
      "100": "#E8EEEC",
      "200": "#DDE4E2",
      "300": "#C4CFCC",
      "400": "#98A4A1",
      "500": "#647370",
      "600": "#4A5754",
      "700": "#36423F",
      "800": "#26302E",
      "850": "#1F2826",
      "900": "#121816",
      "950": "#050807"
    },
    "green": {
      "50": "#ECFDF3",
      "400": "#4ADE80",
      "700": "#15803D",
      "950": "#06281A"
    },
    "amber": {
      "50": "#FFFAEB",
      "400": "#FDB022",
      "600": "#DC6803",
      "700": "#B54708",
      "950": "#3B1D04"
    },
    "red": {
      "50": "#FEF3F2",
      "400": "#F97066",
      "600": "#D92D20",
      "700": "#B42318",
      "950": "#3D0F0B"
    },
    "teal": {
      "50": "#E3F7F3",
      "100": "#C6EFE7",
      "200": "#99E6D8",
      "300": "#5EEAD4",
      "400": "#2DD4BF",
      "500": "#14B8A6",
      "600": "#0E8577",
      "700": "#0F766E",
      "800": "#0B5E57",
      "900": "#0B2A26",
      "950": "#03241F"
    }
  },
  "color": {
    "bg": {
      "light": "#F2F5F4",
      "dark": "#050807",
      "use": "app/window background (canvas)"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#121816",
      "use": "cards, list groups, inputs"
    },
    "surfaceRaised": {
      "light": "#FFFFFF",
      "dark": "#1A2220",
      "use": "menus, popovers, dialogs (solid fallback for glass)"
    },
    "fill": {
      "light": "#E8EEEC",
      "dark": "#1F2826",
      "use": "secondary buttons, chips, hover rows, skeletons"
    },
    "border": {
      "light": "#DDE4E2",
      "dark": "#26302E",
      "use": "hairlines, card outlines, dividers",
      "lightHC": "#98A4A1",
      "darkHC": "#4A5754"
    },
    "borderStrong": {
      "light": "#C4CFCC",
      "dark": "#36423F",
      "use": "input outlines",
      "lightHC": "#647370",
      "darkHC": "#647370"
    },
    "textPrimary": {
      "light": "#0B1513",
      "dark": "#F2F7F5",
      "use": "titles, body text"
    },
    "textSecondary": {
      "light": "#4A5754",
      "dark": "#A5B1AE",
      "use": "subtitles, descriptions, labels",
      "lightHC": "#36423F",
      "darkHC": "#C4CFCC"
    },
    "textTertiary": {
      "light": "#5F6D6A",
      "dark": "#808C89",
      "use": "placeholders, timestamps, captions",
      "lightHC": "#4A5754",
      "darkHC": "#A5B1AE"
    },
    "textOnAccent": {
      "light": "#FFFFFF",
      "dark": "#03241F",
      "use": "text/icons on accent fill (dark mode: bright accent + dark text)"
    },
    "textOnDanger": {
      "light": "#FFFFFF",
      "dark": "#FFFFFF",
      "use": "text/icons on dangerFill"
    },
    "accent": {
      "light": "#0E8577",
      "dark": "#2DD4BF",
      "use": "primary buttons, selected states, active tab, toggles, progress",
      "lightHC": "#0B5E57",
      "darkHC": "#5EEAD4"
    },
    "accentHover": {
      "light": "#0F766E",
      "dark": "#5EEAD4",
      "use": "hover/pressed accent fill"
    },
    "accentSubtle": {
      "light": "#E3F7F3",
      "dark": "#0B2A26",
      "use": "selected row, accent badge, icon boxes, info banners"
    },
    "accentText": {
      "light": "#0B6E64",
      "dark": "#5EEAD4",
      "use": "links, accent text/icons on surfaces",
      "lightHC": "#0B5E57",
      "darkHC": "#99E6D8"
    },
    "focusRing": {
      "light": "#14B8A6",
      "dark": "#2DD4BF",
      "use": "2px focus outline with 2px offset"
    },
    "success": {
      "light": "#15803D",
      "dark": "#4ADE80",
      "use": "positive amounts, success icons/text"
    },
    "successSubtle": {
      "light": "#ECFDF3",
      "dark": "#06281A",
      "use": "success banner/badge bg"
    },
    "warning": {
      "light": "#B54708",
      "dark": "#FDB022",
      "use": "warning icons/text"
    },
    "warningSubtle": {
      "light": "#FFFAEB",
      "dark": "#3B1D04",
      "use": "warning banner/badge bg"
    },
    "danger": {
      "light": "#B42318",
      "dark": "#F97066",
      "use": "errors, destructive text/icons"
    },
    "dangerFill": {
      "light": "#D92D20",
      "dark": "#D92D20",
      "use": "destructive button fill (white text)"
    },
    "dangerSubtle": {
      "light": "#FEF3F2",
      "dark": "#3D0F0B",
      "use": "error banner/badge bg"
    },
    "overlay": {
      "light": "#0B151366",
      "dark": "#00000099",
      "use": "scrim behind modals/sheets"
    },
    "glass": {
      "light": "#FFFFFF73",
      "dark": "#28323073",
      "use": "Liquid Glass body tint (web) — see glass tokens"
    },
    "glassStrong": {
      "light": "#FFFFFFC7",
      "dark": "#1A2220C7",
      "use": "glass for large panels (dialogs, menus) — more opaque for legibility"
    },
    "glassHighlight": {
      "light": "#FFFFFFE6",
      "dark": "#FFFFFF40",
      "use": "specular rim highlight (top-left light)"
    },
    "glassEdge": {
      "light": "#0B15131F",
      "dark": "#00000080",
      "use": "darkened outer edge (iOS 27)"
    }
  },
  "contrastPairs": [
    [
      "textPrimary",
      "bg"
    ],
    [
      "textPrimary",
      "surface"
    ],
    [
      "textSecondary",
      "surface"
    ],
    [
      "textSecondary",
      "bg"
    ],
    [
      "textTertiary",
      "surface"
    ],
    [
      "textTertiary",
      "bg"
    ],
    [
      "textOnAccent",
      "accent"
    ],
    [
      "textOnAccent",
      "accentHover"
    ],
    [
      "accentText",
      "surface"
    ],
    [
      "accentText",
      "accentSubtle"
    ],
    [
      "success",
      "surface"
    ],
    [
      "warning",
      "surface"
    ],
    [
      "danger",
      "surface"
    ],
    [
      "danger",
      "dangerSubtle"
    ],
    [
      "success",
      "successSubtle"
    ],
    [
      "warning",
      "warningSubtle"
    ],
    [
      "textPrimary",
      "fill"
    ],
    [
      "textSecondary",
      "fill"
    ],
    [
      "textOnDanger",
      "dangerFill"
    ]
  ],
  "font": {
    "family": {
      "web": "'Inter Variable', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "webMono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
      "apple": "SF Pro (system)",
      "android": "Roboto (system default) — Inter optional via res/font"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "type": {
    "display": {
      "size": 34,
      "line": 40,
      "weight": 700,
      "tracking": -0.4,
      "apple": "largeTitle",
      "material": "displaySmall"
    },
    "title1": {
      "size": 28,
      "line": 34,
      "weight": 700,
      "tracking": -0.3,
      "apple": "title",
      "material": "headlineMedium"
    },
    "title2": {
      "size": 22,
      "line": 28,
      "weight": 600,
      "tracking": -0.2,
      "apple": "title2",
      "material": "headlineSmall"
    },
    "title3": {
      "size": 20,
      "line": 26,
      "weight": 600,
      "tracking": -0.1,
      "apple": "title3",
      "material": "titleLarge"
    },
    "headline": {
      "size": 17,
      "line": 24,
      "weight": 600,
      "tracking": 0,
      "apple": "headline",
      "material": "titleMedium"
    },
    "body": {
      "size": 16,
      "line": 24,
      "weight": 400,
      "tracking": 0,
      "apple": "body",
      "material": "bodyLarge"
    },
    "callout": {
      "size": 15,
      "line": 22,
      "weight": 400,
      "tracking": 0,
      "apple": "callout",
      "material": "bodyMedium"
    },
    "subheadline": {
      "size": 14,
      "line": 20,
      "weight": 500,
      "tracking": 0,
      "apple": "subheadline",
      "material": "labelLarge"
    },
    "footnote": {
      "size": 13,
      "line": 18,
      "weight": 400,
      "tracking": 0,
      "apple": "footnote",
      "material": "bodySmall"
    },
    "caption": {
      "size": 12,
      "line": 16,
      "weight": 500,
      "tracking": 0.2,
      "apple": "caption",
      "material": "labelMedium"
    }
  },
  "space": {
    "0": 0,
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48,
    "4xl": 64
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 20,
    "xl": 28,
    "full": 9999
  },
  "size": {
    "controlSm": 32,
    "controlMd": 44,
    "controlLg": 52,
    "controlCompact": 28,
    "minTouchApple": 44,
    "minTouchAndroid": 48,
    "iconSm": 16,
    "iconMd": 20,
    "iconLg": 24,
    "avatarSm": 32,
    "avatarMd": 40,
    "avatarLg": 56,
    "listRow": 56,
    "listRowCompact": 36,
    "navBarWeb": 64,
    "sidebarWeb": 248,
    "sidebarMac": 220,
    "containerMax": 1200,
    "readingMax": 680
  },
  "elevation": {
    "none": "none",
    "sm": {
      "y": 1,
      "blur": 2,
      "color": "#1018280D",
      "use": "inputs, small cards (light only)"
    },
    "md": {
      "y": 4,
      "blur": 12,
      "color": "#10182814",
      "use": "cards on hover, dropdowns"
    },
    "lg": {
      "y": 12,
      "blur": 32,
      "color": "#1018281F",
      "use": "modals, popovers, toasts"
    },
    "darkModeRule": "In dark mode do not rely on shadows: use surfaceRaised + 1px border instead."
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "rule": "Spring physics everywhere (same response/damping on all platforms). Animate opacity/transform only. Reduce Motion / prefers-reduced-motion / Android 'Remove animations' → replace movement with short crossfades.",
    "springs": {
      "standard": {
        "response": 0.35,
        "dampingFraction": 0.85,
        "use": "most UI movement: tab lens, sheet/morph geometry, minimize"
      },
      "bouncy": {
        "response": 0.4,
        "dampingFraction": 0.68,
        "use": "glass reacting to touch: press grow, glass materializing, FAB menu"
      }
    },
    "press": {
      "glassScale": 1.06,
      "buttonScale": 0.97,
      "use": "glass grows under the finger (iOS 27); solid content buttons shrink slightly"
    }
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "radiusUse": {
    "control": "full — buttons, segmented controls, chips, search fields, tab bar (capsules, like iOS/macOS 27)",
    "input": "md 12 — text fields, selects, banners",
    "card": "lg 20 — cards, grouped list sections",
    "sheet": "xl 28 — sheets, dialogs, popovers",
    "nested": "inner radius = outer radius − padding (concentric corners)"
  },
  "glass": {
    "blur": 14,
    "saturate": 190,
    "brightness": 1.04,
    "rule": "Glass is ONLY for the floating navigation/control layer (tab bar, nav buttons, floating buttons, toasts, menus, sheets). Never on content cards. Glass needs color behind it: content provides it; reduced transparency → solid surfaceRaised."
  }
}